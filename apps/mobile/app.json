{
  "expo": {
    "name": "Unspent",
    "slug": "unspent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "unspent",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFBF9"
    },
    "ios": {
      "bundleIdentifier": "app.unspent",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "privacyManifestKeys": {
        "NSPrivacyAccessedAPITypes": ["NSPrivacyAccessedAPICategoryUserDefaults"],
        "NSPrivacyAccessedAPICategoryTimestamp": "NSPrivacyAccessedAPICategoryTimestamp"
      }
    },
    "android": {
      "package": "app.unspent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFBF9"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Unspent to access your photos to add wishlist items.",
          "cameraPermission": "Allow Unspent to use your camera to capture wishlist items."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8B4B8"
        }
      ],
      [
        "expo-auth-session",
        {
          "scheme": "unspent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "unspent-app"
      }
    }
  }
}