{
  "name": "@unspent/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build": "expo run:expo",
    "build:android": "expo run:android --variant release",
    "build:ios": "expo run:ios --configuration Release",
    "build:preview": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform ios",
    "submit": "eas submit --latest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^6.1.9",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.1",
    "expo": "~52.0.0",
    "expo-auth-session": "~6.0.0",
    "expo-image-picker": "~15.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.28.0",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.0",
    "expo-splash-screen": "~0.28.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "nativewind": "^4.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-view-shot": "~4.0.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.5.0",
    "@unspent/shared": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "private": true
}