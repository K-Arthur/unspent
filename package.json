{
  "name": "unspent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:mobile": "pnpm --filter @unspent/mobile run dev",
    "dev:web": "pnpm --filter @unspent/web run dev",
    "build": "pnpm --recursive run build",
    "build:mobile": "pnpm --filter @unspent/mobile run build",
    "build:web": "pnpm --filter @unspent/web run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}