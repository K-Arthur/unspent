{
  "name": "unspent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:web": "pnpm --filter @unspent/web dev",
    "dev:mobile": "pnpm --filter @unspent/mobile dev",
    "build:web": "pnpm --filter @unspent/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "supabase:start": "supabase start",
    "supabase:db:push": "supabase db push",
    "supabase:functions": "supabase functions serve",
    "supabase:lint": "supabase db lint"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1"
  },
  "dependencies": {
    "pnpm": "10.33.2"
  }
}
