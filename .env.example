# Unspent Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE (Required)
# ===========================================
# Get these from your Supabase dashboard: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ===========================================
# AUTHENTICATION (Optional - for OAuth)
# ===========================================
# Apple Sign-In: https://developer.apple.com
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# Google Sign-In: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# STRIPE (for subscriptions)
# ===========================================
# Get these from Stripe Dashboard: Developers > API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Monthly/Yearly Price IDs from Stripe Dashboard
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# ===========================================
# REVENUECAT (for mobile IAP - optional)
# ===========================================
REVENUECAT_API_KEY=your-revenuecat-api-key

# ===========================================
# EXPO & EAS
# ===========================================
EXPO_PROJECT_ID=your-expo-project-id
EAS_PROJECT_ID=your-eas-project-id

# ===========================================
# OPENAI (for AI features)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# SEARCH APIs (for dupe finder)
# ===========================================
# Get from https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Or use Amazon Associates (https://affiliate-program.amazon.com)
ASSOCIATES_TAG=your-tag-20

# ===========================================
# AFFILIATE TRACKING
# ===========================================
# Get from https://skimlinks.com
SKIMLINKS_ID=your-skimlinks-publisher-id

# ===========================================
# EMAIL (Resend - for transactional emails)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key

# ===========================================
# SENTRY (error tracking)
# ===========================================
SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# POSTHOG (analytics)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# ===========================================
# CLOUDFLARE R2 (for image storage)
# ===========================================
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=unspent-screenshots
R2_ACCOUNT_ID=your-r2-account-id

# ===========================================
# APP CONFIGURATION
# ===========================================
# Deep link scheme for your app
APP_SCHEME=unspent

# App Store URLs
APPLE_STORE_URL=https://apps.apple.com/app/unspent
GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=app.unspent

# Web URL
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ===========================================
# RATE LIMITS (optional)
# ===========================================
# For Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token